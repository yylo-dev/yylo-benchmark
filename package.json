{
  "name": "@yylo/benchmark",
  "version": "0.1.3",
  "description": "YYLO Benchmark: thin task/workflow experiments and independent evaluations",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "yylo-benchmark": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "scripts/verify-v2-packed-acceptance.mjs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepack": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "dotenv": "^16.6.1",
    "yaml": "^2.9.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vitest": "^1.0.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yylo-dev/yylo-benchmark.git"
  },
  "bugs": {
    "url": "https://github.com/yylo-dev/yylo-benchmark/issues"
  },
  "homepage": "https://yylo.dev",
  "author": {
    "name": "JUNO AI INC.",
    "email": "support@yylo.dev"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
